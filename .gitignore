# Top-level .gitignore for the repository

# Node.js dependencies (ignore in any subfolder)
**/node_modules/

# Package manager artifacts
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# dotenv environment variables (do NOT commit secrets)
.env
.env.*

# Frontend build outputs
**/.next/
**/out/
**/build/
**/dist/

# Vercel / deployment
.vercel

# Docker
docker-compose.override.yml

# macOS
.DS_Store

# Editors
.vscode/
.idea/

# TypeScript
*.tsbuildinfo

# Temporary files
*.tmp
*.temp

# PEM/keys
*.pem

# Generated files
next-env.d.ts

